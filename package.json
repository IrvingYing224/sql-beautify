{
	"name": "vscode-sql-beautify",
	"displayName": "SQL Beautify",
	"description": "Hive-first SQL formatter with lossless token handling, fail-closed edits, and experimental Hive DDL tools / Hive 优先的安全 SQL 格式化器",
	"version": "2.2.1",
	"publisher": "clarkyu",
	"maintainers": [
		"IrvingYing224"
	],
	"engines": {
		"vscode": "^1.90.0"
	},
	"keywords": [
		"hive",
		"sql",
		"formatters",
		"格式化",
		"美化",
		"beautify"
	],
	"categories": [
		"Formatters"
	],
	"activationEvents": [
		"onLanguage:sql",
		"onLanguage:hive-sql"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/IrvingYing224/sql-beautify.git"
	},
	"main": "./dist/extension.cjs",
	"exports": {
		"./formatter": {
			"types": "./dist/sql-formatter.d.cts",
			"default": "./dist/sql-formatter.cjs"
		},
		"./experimental/ddl": {
			"types": "./dist/hive-ddl.d.cts",
			"default": "./dist/hive-ddl.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/extension.cjs",
		"dist/runtime.cjs",
		"dist/sql-formatter.cjs",
		"dist/hive-ddl.cjs",
		"dist/formatter-worker.cjs",
		"dist/sql-formatter.d.cts",
		"dist/hive-ddl.d.cts",
		"images/icon.png",
		"README.md",
		"CHANGELOG.md",
		"LICENSE.txt"
	],
	"contributes": {
		"commands": [
			{
				"command": "sqlBeautify.formatSql",
				"title": "SQL Beautify: Format SQL",
				"enablement": "editorLangId == sql || editorLangId == hive-sql"
			},
			{
				"command": "sqlBeautify.formatHiveDdl",
				"title": "SQL Beautify: Format Hive DDL (Experimental)",
				"enablement": "editorLangId == sql || editorLangId == hive-sql"
			},
			{
				"command": "sqlBeautify.extractHiveDdl",
				"title": "SQL Beautify: Extract Hive DDL (Experimental)",
				"enablement": "editorLangId == sql || editorLangId == hive-sql"
			},
			{
				"command": "sqlBeautify.copySafeDiagnosticReport",
				"title": "SQL Beautify: Copy Safe Diagnostic Report",
				"enablement": "editorLangId == sql || editorLangId == hive-sql"
			}
		],
		"keybindings": [
			{
				"command": "sqlBeautify.formatHiveDdl",
				"key": "alt+shift+l",
				"when": "editorTextFocus && !editorReadonly && (editorLangId == sql || editorLangId == hive-sql)"
			},
			{
				"command": "sqlBeautify.extractHiveDdl",
				"key": "alt+shift+;",
				"when": "editorTextFocus && !editorReadonly && (editorLangId == sql || editorLangId == hive-sql)"
			}
		],
		"configuration": {
			"type": "object",
			"title": "SQL Beautify",
			"properties": {
				"sqlBeautify.keywordCase": {
					"scope": "language-overridable",
					"type": "string",
					"enum": [
						"upper",
						"lower"
					],
					"default": "upper",
					"description": "Keyword case for formatted SQL. /格式化后的 SQL 关键词大小写"
				},
				"sqlBeautify.commaStyle": {
					"scope": "language-overridable",
					"type": "string",
					"enum": [
						"leading",
						"trailing"
					],
					"default": "leading",
					"description": "Comma placement style. /逗号位置风格"
				},
				"sqlBeautify.indentStyle": {
					"scope": "language-overridable",
					"type": "string",
					"enum": [
						"tab",
						"space"
					],
					"default": "space",
					"description": "Indentation style for formatted SQL. /格式化缩进风格"
				},
				"sqlBeautify.maxAlignWidth": {
					"scope": "language-overridable",
					"type": "integer",
					"default": 150,
					"minimum": 1,
					"maximum": 500,
					"description": "Maximum code width for AS and trailing comment alignment. /AS 和行尾注释对齐的最大代码宽度"
				},
				"sqlBeautify.caseWhenThenWrapLength": {
					"scope": "language-overridable",
					"type": "integer",
					"default": 50,
					"minimum": 1,
					"maximum": 300,
					"description": "Wrap threshold for CASE WHEN THEN and ELSE values. /CASE WHEN 中 THEN 和 ELSE 值的换行阈值"
				},
				"sqlBeautify.caseLayout": {
					"scope": "language-overridable",
					"type": "string",
					"enum": [
						"expanded",
						"compactShort"
					],
					"default": "expanded",
					"description": "CASE expression layout strategy. /CASE 表达式布局策略"
				},
				"sqlBeautify.dialect": {
					"scope": "language-overridable",
					"type": "string",
					"enum": [
						"generic",
						"hive",
						"postgresql",
						"mysql"
					],
					"default": "hive",
					"description": "Best-effort SQL dialect boundary handling. Hive remains the primary formatting target. /SQL 方言边界处理；Hive 仍是主要格式化目标"
				},
				"sqlBeautify.unsupportedSyntaxPolicy": {
					"scope": "language-overridable",
					"type": "string",
					"enum": [
						"preserve",
						"warn",
						"bail_out"
					],
					"default": "warn",
					"description": "Policy for unsupported or unmodeled syntax. /未建模语法的处理策略"
				},
				"sqlBeautify.debugDiagnostics": {
					"scope": "window",
					"type": "boolean",
					"default": false,
					"description": "Enable opt-in debug diagnostics in the extension host console; output may expose SQL fragments, error stacks, and local file paths. /在扩展宿主控制台输出可选调试信息；内容可能暴露 SQL 片段、错误栈和本地文件路径"
				}
			}
		}
	},
	"scripts": {
		"test:verify": "node scripts/run-v2-suite.js verify",
		"package:vsix": "node scripts/package-vsix.js",
		"prepack": "node scripts/build-v2-runtime.js",
		"verify:clean-package": "node scripts/verify-clean-package.js",
		"typecheck:v2": "tsc -p tsconfig.v2.json",
		"build:v2-core": "node scripts/build-v2-core.js",
		"build:v2-runtime": "node scripts/build-v2-runtime.js",
		"test:v2:lexer": "node scripts/run-v2-suite.js lexer",
		"test:v2:lexer-performance": "node scripts/run-v2-suite.js lexer-performance",
		"test:v2:wave1": "node scripts/run-v2-suite.js wave1",
		"test:v2:wave2-foundation": "node scripts/run-v2-suite.js wave2-foundation",
		"test:v2:hive-cst": "node scripts/run-v2-suite.js hive-cst",
		"test:v2:wave2-corpus": "node scripts/run-v2-suite.js wave2-corpus",
		"test:v2:wave2-performance": "node scripts/run-v2-suite.js wave2-performance",
		"test:v2:expression": "node scripts/run-v2-suite.js expression",
		"test:v2:recovery": "node scripts/run-v2-suite.js recovery",
		"test:v2:trivia": "node scripts/run-v2-suite.js trivia",
		"test:v2:analysis": "node scripts/run-v2-suite.js analysis",
		"test:v2:support-matrix": "node scripts/run-v2-suite.js support-matrix",
		"test:v2:wave2": "node scripts/run-v2-suite.js wave2",
		"test:v2:wave3-foundation": "node scripts/run-v2-suite.js wave3-foundation",
		"test:v2:source-map-memory": "node scripts/run-v2-suite.js source-map-memory",
		"test:v2:wave3": "node scripts/run-v2-suite.js wave3",
		"test:v2:wave4": "node scripts/run-v2-suite.js wave4",
		"test:v2:wave5-stage-a": "node scripts/run-v2-suite.js wave5-stage-a",
		"test:v2:corpus": "node scripts/run-v2-suite.js corpus",
		"test:v2:wave5-stage-b": "node scripts/run-v2-suite.js wave5-stage-b",
		"test:v2:wave5": "node scripts/run-v2-suite.js wave5",
		"test:v2:performance-relative": "node scripts/run-v2-suite.js performance-relative",
		"test:v2:node-smoke": "node scripts/run-v2-suite.js node-smoke",
		"test:v2:infrastructure": "node scripts/run-v2-suite.js infrastructure",
		"test:production-private": "node scripts/run-v2-suite.js production-private",
		"test:vscode-smoke": "npm run build:v2-runtime && node scripts/run-vscode-smoke.js"
	},
	"vsce": {
		"dependencies": false
	},
	"icon": "images/icon.png",
	"devDependencies": {
		"@types/vscode": "1.90.0",
		"@vscode/test-electron": "2.5.2",
		"@vscode/vsce": "^3.2.2",
		"esbuild": "0.28.1",
		"typescript": "6.0.3"
	}
}
